#!/bin/sh
# Clickscope snap command-chain launcher.
#
# Runs after the gnome extension's desktop-launch (so these exports win) and
# immediately exec's the app. Its only job is to quiet a batch of harmless
# startup warnings that appear when the strict snap runs under WSLg — where
# there is no working DRI/Zink GPU, no xdg-desktop-portal, no host ibus, and
# no AT-SPI accessibility bus. Every override is gated on WSL detection so a
# native Ubuntu GNOME desktop is left completely untouched (it keeps hardware
# GL, portals, input methods and accessibility).
if grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
    # Mesa cannot reach /dev/dri under WSLg and its Zink (GL-on-Vulkan) probe
    # fails with VK_ERROR_INCOMPATIBLE_DRIVER; go straight to llvmpipe instead
    # of logging the EGL/MESA-LOADER/ZINK errors. Value "1" (not "true", which
    # only newer Mesa accepts).
    export LIBGL_ALWAYS_SOFTWARE=1
    # No xdg-desktop-portal is running, so don't try to read the Settings
    # portal (avoids the "No such interface org.freedesktop.portal.Settings").
    export GTK_USE_PORTAL=0
    # There is no host ibus; the extension's GTK_IM_MODULE=ibus makes libibus
    # mkdir a confined-away path and log ENOTDIR. Use GTK's built-in compose
    # context — the app has no input-method needs.
    export GTK_IM_MODULE=gtk-im-context-simple
    export XMODIFIERS=@im=none
    # NOTE on accessibility (atk): under WSLg there is no AT-SPI bus, so GTK's
    # atk path occasionally logs a benign "get_device_events_reply: unknown
    # signature" warning. We deliberately do NOT set NO_AT_BRIDGE/GTK_A11Y:
    # half-disabling at-spi turns that *intermittent* WARNING into a
    # *consistent* Atk-CRITICAL atk_socket_embed assertion (equally harmless
    # but louder). Leaving accessibility alone is the quieter option.
fi

# Give GDK a cursor theme that is always present in the snap (Adwaita ships in
# gtk-common-themes). The ${VAR:-default} form never clobbers a theme the
# session already set, so this is safe everywhere. (Note: this does not
# suppress GDK's one-off "empty cursor name" notice under WSLg, which is
# harmless — the cursor still resolves via the theme.)
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"

exec "$@"
